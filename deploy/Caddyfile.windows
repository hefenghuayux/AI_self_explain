{
	admin 127.0.0.1:20198
	auto_https off
}

http://:18081 {
	bind 127.0.0.1
	root * "{$SELF_EXPLAIN_STATIC_ROOT}"
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:18082
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
